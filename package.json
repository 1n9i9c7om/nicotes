{
  "name": "nicotes",
  "version": "0.4.2",
  "license": "AGPL-3.0-only",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -n server,web -c cyan,blue \"npm run dev -w apps/server\" \"npm run dev -w apps/web\"",
    "build": "npm run build -w apps/web && npm run build -w apps/server",
    "start": "npm run start -w apps/server",
    "restore": "npm run restore -w apps/server --",
    "reset-2fa": "npm run reset-2fa -w apps/server --",
    "test": "npm run test --workspaces --if-present && node --test extension/*.test.js",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "e2e": "npm run build && npm run e2e -w apps/e2e --"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "concurrently": "^10.0.6",
    "typescript": "^7.0.2"
  }
}

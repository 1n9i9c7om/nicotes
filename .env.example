# Account created on first start (leave empty to use the setup screen instead)
NICOTES_ADMIN_USER=admin
NICOTES_ADMIN_PASSWORD=change-me

# Set to true when Nicotes is served over HTTPS (e.g. behind a reverse proxy)
NICOTES_SECURE_COOKIES=false

# Encrypts API keys stored in the database. Optional: without it a random key is
# generated in the data volume (data/secret.key). Keep it stable once set.
# NICOTES_SECRET=

# --- Import (all optional; can also be set per account under Settings) ---

# OpenRouter: summarises and structures imported pages
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=z-ai/glm-5.3-flashx

# crawl4ai: renders JavaScript-heavy pages (see compose.crawl4ai.yml).
# The token must match crawl4ai's CRAWL4AI_API_TOKEN.
# CRAWL4AI_URL=http://crawl4ai:11235
# CRAWL4AI_TOKEN=

# --- Research & AI (optional; also under Settings) ---

# Research uses SearXNG when set (needs search.formats: [html, json]), otherwise
# OpenRouter's web search. compose.searxng.yml runs one; it needs SEARXNG_SECRET.
# SEARXNG_URL=http://searxng:8080
# SEARXNG_SECRET=
# OPENROUTER_RESEARCH_MODEL=
# Spending limit per AI run in USD (default 0.50)
# NICOTES_AI_COST_LIMIT=0.5

# Allow importing from hosts on private networks (off by default to prevent SSRF)
# NICOTES_IMPORT_ALLOW_PRIVATE=false

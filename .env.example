# Nicotes settings. Copy this file to .env next to docker-compose.yml.

# ─── Required ───────────────────────────────────────────────────────────────────────

# The first account, created when Nicotes starts for the first time. Choose your own
# password (at least 8 characters): Nicotes refuses to start with the example one.
# Leave both empty to create the account on a setup screen instead.
NICOTES_ADMIN_USER=admin
NICOTES_ADMIN_PASSWORD=change-me

# true when you reach Nicotes over HTTPS (for example behind a reverse proxy).
NICOTES_SECURE_COOKIES=false

# ─── Optional ───────────────────────────────────────────────────────────────────────
# Everything below has a working default. To change a setting, remove the # in front of
# it, then run `docker compose up -d` again.

# These can also be set later in the app, under Settings (a value saved there wins):

# AI features: an OpenRouter and/or a Routeway key, and the model they use by default.
# Routeway models are written as routeway:<id>.
# OPENROUTER_API_KEY=
# ROUTEWAY_API_KEY=
# Your own model server (Ollama, LM Studio, …): the address of its OpenAI API and, if it
# wants one, a key. Its models are written as local:<id>.
# LOCAL_AI_URL=http://ollama:11434/v1
# LOCAL_AI_KEY=
# OPENROUTER_MODEL=z-ai/glm-5.3-flashx
# A different model per feature (Settings → AI models); unset ones use OPENROUTER_MODEL.
# OPENROUTER_IMPORT_MODEL=
# OPENROUTER_ORGANIZE_MODEL=
# OPENROUTER_RESEARCH_MODEL=
# OPENROUTER_ASK_MODEL=
# OPENROUTER_ASSISTANT_MODEL=
# OPENROUTER_SUMMARY_MODEL=
# OPENROUTER_LINKS_MODEL=
# OPENROUTER_LAYOUT_MODEL=
# OPENROUTER_IMAGES_MODEL=
# Spending limit per AI run in USD.
# NICOTES_AI_COST_LIMIT=0.5
# Semantic index (related pages, search by meaning, better answers in Ask). When on, the
# text of your notes is sent to OpenRouter for embeddings.
# NICOTES_SEMANTIC_INDEX=false
# OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-small
# Search in photos and scanned images: each image is sent once to the "Reading images" model
# (OPENROUTER_IMAGES_MODEL), which needs to accept images.
# NICOTES_READ_IMAGES=false
# Web research through your own SearXNG (compose.searxng.yml runs one) instead of the AI
# service's web search.
# SEARXNG_URL=http://searxng:8080
# crawl4ai renders JavaScript-heavy pages for imports (compose.crawl4ai.yml runs one).
# CRAWL4AI_URL=http://crawl4ai:11235
# CRAWL4AI_TOKEN=
# Task reminders in Telegram: the token of a bot you made with @BotFather.
# TELEGRAM_BOT_TOKEN=

# These are only set here:

# Which release to run (default: the newest) and the port on this machine.
# NICOTES_TAG=v0.4.2
# NICOTES_HTTP_PORT=3000
# Let the Nicotes browser extension show Nicotes in the browser's sidebar.
# NICOTES_BROWSER_EXTENSION=false
# Backups: a host folder for them, e.g. on a NAS (the container user, uid 1000, needs write
# access), hours between them (0 turns them off), and how many daily and weekly ones to keep.
# NICOTES_BACKUP_PATH=/mnt/nas/nicotes-backups
# NICOTES_BACKUP_INTERVAL_HOURS=24
# NICOTES_BACKUP_KEEP_DAILY=7
# NICOTES_BACKUP_KEEP_WEEKLY=4
# Key that encrypts the API keys saved in Nicotes. Without it, one is generated in the data
# volume. Keep it the same once set.
# NICOTES_SECRET=
# Allow imports from addresses on your own network (off to protect against SSRF).
# NICOTES_IMPORT_ALLOW_PRIVATE=false
# Secret for the optional SearXNG container (compose.searxng.yml). The crawl4ai container
# (compose.crawl4ai.yml) uses CRAWL4AI_TOKEN from above.
# SEARXNG_SECRET=
